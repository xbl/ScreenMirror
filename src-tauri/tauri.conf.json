{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenmirror",
  "version": "0.1.0",
  "identifier": "dev.screenmirror.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Screenmirror",
        "width": 940,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
