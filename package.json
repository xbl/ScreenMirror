{
  "name": "screenmirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:screenkit": "MACOSX_DEPLOYMENT_TARGET=13.0 SCREENMIRROR_USE_IOSURFACE=1 tauri dev --features screenkit",
    "tauri:build:screenkit": "MACOSX_DEPLOYMENT_TARGET=13.0 SCREENMIRROR_USE_IOSURFACE=1 tauri build --features screenkit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.3",
    "vue": "^3.4.0",
    "vue-i18n": "^9.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
